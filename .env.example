# LocalStack or any S3-compatible endpoint (required — app will error clearly if absent)
AWS_ENDPOINT_URL=http://localhost:4566

# AWS region sent to the SDK (defaults to us-east-1 if unset)
AWS_REGION=us-east-1

# Credentials — LocalStack accepts any non-empty value
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
